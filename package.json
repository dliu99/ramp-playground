{
  "name": "pr-review-room",
  "private": true,
  "type": "module",
  "scripts": {
    "hooks:install": "bun run src/hooks.ts install",
    "hooks:uninstall": "bun run src/hooks.ts uninstall",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "sample": "bun run src/sample.ts",
    "review": "bun run src/pre-push.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "typescript": "5.7.3"
  },
  "dependencies": {
    "next": "16.1.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  }
}
